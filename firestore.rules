// Reguły Firestore dla prototypu E1.
// Jak wkleić: konsola Firebase -> Firestore Database -> Reguły (Rules),
// zastąp całą zawartość tym plikiem, w miejsce WKLEJ_UID wstaw swój uid
// (pokazuje go aplikacja po zalogowaniu, przycisk „Kopiuj uid”), kliknij Publikuj (Publish).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "WKLEJ_UID";
    }
  }
}
