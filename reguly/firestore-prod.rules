// Reguły Firestore – projekt osk-dziennik (prod). Dostęp tylko dla konta instruktora (po uid).
// Konsola Firebase → projekt osk-dziennik → Firestore Database → Reguły (Rules): zastąp całość tym tekstem,
// w miejsce WKLEJ_UID_PRODUKCJI wstaw uid z aplikacji (Więcej → Konto → Kopiuj uid), kliknij Opublikuj (Publish).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "WKLEJ_UID_PRODUKCJI";
    }
  }
}
