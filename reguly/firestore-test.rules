// Reguły Firestore – projekt osk-test-3c32a (test). Dostęp tylko dla konta instruktora (po uid).
// Konsola Firebase → projekt osk-test-3c32a → Firestore Database → Reguły (Rules): zastąp całość tym tekstem,
// w miejsce WKLEJ_UID_TESTU wstaw uid z aplikacji (Więcej → Konto → Kopiuj uid), kliknij Opublikuj (Publish).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "WKLEJ_UID_TESTU";
    }
  }
}
